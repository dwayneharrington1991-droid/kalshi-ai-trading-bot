[Unit]
Description=Kalshi signals-only private dashboard
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=kalshi-signals
Group=kalshi-signals
WorkingDirectory=/opt/kalshi-signals/app
Environment=PYTHONUNBUFFERED=1
Environment=KALSHI_MONITOR_PRIVATE_KEY_PATH=/etc/kalshi-signals/kalshi-monitor.pem
EnvironmentFile=-/etc/kalshi-signals/account.env
ExecStart=/opt/kalshi-signals/app/deploy/hetzner/run-signals.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
ReadWritePaths=/var/lib/kalshi-signals /var/log/kalshi-signals
MemoryHigh=5G
MemoryMax=6G
TasksMax=256
UMask=0027

[Install]
WantedBy=multi-user.target
