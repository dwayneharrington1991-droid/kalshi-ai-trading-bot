# Non-secret deployment paths. Install as /etc/kalshi-signals/deployment.env.
APP_ROOT=/home/opc/kalshi-ai-trading-bot
DEPLOY_ROOT=/home/opc/kalshi-ai-trading-bot/.deploy
DATA_ROOT=/home/opc/kalshi-ai-trading-bot/data
BACKUP_ROOT=/home/opc/kalshi-backups
SERVICE_NAME=kalshi-signals.service
PYTHON_BIN=/usr/bin/python3
JOURNAL_PATH=/home/opc/kalshi-ai-trading-bot/data/signals_monitor.db
ACCOUNT_STORE_PATH=/home/opc/kalshi-ai-trading-bot/data/signals_account_monitor.db
MODEL_ARTIFACT=/home/opc/kalshi-ai-trading-bot/data/models/signals_model.json
OPENING_MODEL_ARTIFACT=/home/opc/kalshi-ai-trading-bot/data/models/signals_opening_model.json
MODEL_REGISTRY=/home/opc/kalshi-ai-trading-bot/data/models/signals_model_registry
MODEL_ROOT=/home/opc/kalshi-ai-trading-bot/data/models
ENABLE_ACCOUNT_READONLY=1
REQUIRE_MODEL_ARTIFACTS=0

