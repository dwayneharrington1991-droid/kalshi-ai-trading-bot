# Live BTC order-book + trade-flow collector (read-only public market data; signals-only bot, never trades).
# Separate from the 8768 server; bounded CPU and memory so it cannot push 8768 over its deploy gate.
# Install: copy scripts/orderbook_service.py and src/signals_display/orderbook_live.py into
#   /home/opc/dual-ai-alerts/orderbook/{scripts,src/signals_display}/, then
#   sudo cp deploy/oracle/kalshi-orderbook.service /etc/systemd/system/ && sudo systemctl enable --now kalshi-orderbook
[Unit]
Description=Kalshi 8768 live BTC order books and trade flow (read-only, signals only)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/dual-ai-alerts/orderbook
ExecStart=/bin/bash -c "exec /home/opc/kalshi-ai-trading-bot/.venv/bin/python /home/opc/dual-ai-alerts/orderbook/scripts/orderbook_service.py"
Restart=always
RestartSec=10
Nice=10
CPUQuota=15%
MemoryMax=200M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
