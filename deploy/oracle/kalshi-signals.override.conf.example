[Unit]
# Expose a persistent configuration/programming failure instead of restarting
# forever. Transient failures retain ten recovery attempts over five minutes.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
WorkingDirectory=/home/opc/kalshi-ai-trading-bot/.deploy/current
ExecStart=
ExecStart=/home/opc/kalshi-ai-trading-bot/.deploy/current/deploy/oracle/run_dashboard.sh
Restart=on-failure
RestartSec=5s
TimeoutStartSec=3min
KillMode=control-group

