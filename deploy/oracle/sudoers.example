# Install as /etc/sudoers.d/kalshi-deploy after validating with visudo -cf.
# Replace opc only if the dedicated deployment account differs.
Cmnd_Alias KALSHI_SERVICE = /usr/bin/systemctl restart kalshi-signals.service, \
 /usr/bin/systemctl stop kalshi-signals.service, \
 /usr/bin/systemctl enable kalshi-signals.service, \
 /usr/bin/systemctl is-enabled kalshi-signals.service, \
 /usr/bin/systemctl daemon-reload, \
 /usr/bin/systemctl is-active kalshi-signals.service, \
 /usr/bin/systemctl is-active --quiet kalshi-signals.service, \
 /usr/bin/systemctl cat kalshi-signals.service, \
 /usr/bin/systemctl show kalshi-signals.service *
Cmnd_Alias KALSHI_LEARNING = /usr/bin/systemctl stop kalshi-learning.timer, \
 /usr/bin/systemctl start kalshi-learning.timer, \
 /usr/bin/systemctl enable kalshi-learning.timer, \
 /usr/bin/systemctl is-enabled kalshi-learning.timer, \
 /usr/bin/systemctl stop kalshi-learning.service, \
 /usr/bin/systemctl start kalshi-learning.service, \
 /usr/bin/systemctl is-active --quiet kalshi-learning.timer, \
 /usr/bin/systemctl show kalshi-learning.timer *, \
 /usr/bin/systemctl show kalshi-learning.service *, \
 /usr/bin/install -d -m 0755 /etc/systemd/system/kalshi-learning.service.d, \
 /usr/bin/install -m 0644 /home/opc/kalshi-ai-trading-bot/.deploy/current/deploy/oracle/kalshi-learning.override.conf.example /etc/systemd/system/kalshi-learning.service.d/zz-codex-bounded-learning.conf
Cmnd_Alias KALSHI_CONFIG = /usr/bin/install -d -o root -g opc -m 0750 /etc/kalshi-signals, \
 /usr/bin/install -o root -g opc -m 0640 /home/opc/kalshi-deployment.env.candidate /etc/kalshi-signals/deployment.env, \
 /usr/bin/chown root\:opc /etc/kalshi-signals/deployment.env, \
 /usr/bin/chmod 0640 /etc/kalshi-signals/deployment.env, \
 /usr/bin/test -e /etc/kalshi-signals/deployment.env, \
 /usr/bin/cmp -s /home/opc/kalshi-deployment.env.candidate /etc/kalshi-signals/deployment.env
Cmnd_Alias KALSHI_BASELINE = /usr/bin/install -d -m 0755 /etc/systemd/system/kalshi-signals.service.d, \
 /usr/bin/install -m 0644 /home/opc/.kalshi-deploy/tools/kalshi-signals.override.conf.example /etc/systemd/system/kalshi-signals.service.d/zz-codex-versioned-release.conf, \
 /usr/bin/test -f /etc/systemd/system/kalshi-signals.service.d/zz-codex-versioned-release.conf, \
 /usr/bin/rm -f /etc/systemd/system/kalshi-signals.service.d/zz-codex-versioned-release.conf, \
 /usr/bin/test -f /etc/systemd/system/kalshi-signals.service.d/99-codex-versioned-release.conf, \
 /usr/bin/test -f /etc/systemd/system/kalshi-signals.service.d/99-codex-versioned-release.conf.disabled-by-codex, \
 /usr/bin/mv /etc/systemd/system/kalshi-signals.service.d/99-codex-versioned-release.conf /etc/systemd/system/kalshi-signals.service.d/99-codex-versioned-release.conf.disabled-by-codex, \
 /usr/bin/mv /etc/systemd/system/kalshi-signals.service.d/99-codex-versioned-release.conf.disabled-by-codex /etc/systemd/system/kalshi-signals.service.d/99-codex-versioned-release.conf
opc ALL=(root) NOPASSWD: KALSHI_SERVICE, KALSHI_LEARNING, KALSHI_CONFIG, KALSHI_BASELINE
